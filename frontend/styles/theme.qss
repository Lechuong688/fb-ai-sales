/* Facebook AI Sales: clear surfaces, consistent spacing and a single blue accent. */
QWidget {
    color: #26354b;
    font-family: "Segoe UI";
    font-size: 10pt;
}
QMainWindow, QWidget#mainContent, QWidget#pageViewport,
QWidget#workspacePage, QWidget#dashboardPage {
    background-color: #f5f7fb;
}
QFrame#navigationShell {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #e6ebf2;
}
QWidget#brandHeader { background: #ffffff; }
QLabel#brandMark {
    background: #2563eb;
    color: white;
    border-radius: 10px;
    font-size: 27pt;
    font-weight: 800;
}
QLabel#brandName { color: #132442; font-size: 20pt; font-weight: 800; }
QLabel#navigationCaption {
    color: #98a3b4;
    font-size: 8pt;
    font-weight: 700;
    padding: 14px 22px 10px;
}
QLabel#navigationFooter {
    color: #8491a5;
    font-size: 8.5pt;
    padding: 18px 22px;
    border-top: 1px solid #edf0f5;
}
QListWidget#sidebar {
    background: #ffffff;
    border: none;
    padding: 4px 12px;
    outline: none;
}
QListWidget#sidebar::item {
    color: #617087;
    min-height: 42px;
    padding: 0 12px;
    margin: 2px 0;
    border: none;
    border-radius: 8px;
    font-size: 9.5pt;
    font-weight: 600;
}
QListWidget#sidebar::item:hover { background: #f6f8fc; color: #23416c; }
QListWidget#sidebar::item:selected { background: #edf3ff; color: #2563eb; }
QListWidget#sidebar[compact="true"] { padding: 4px 10px; }
QListWidget#sidebar[compact="true"]::item { padding: 0 12px; }
QFrame#header {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e6ebf2;
}
QLabel#breadcrumb { color: #6d7a90; font-size: 9.5pt; font-weight: 500; }
QToolButton {
    background: #ffffff;
    border: 1px solid #e4e9f1;
    border-radius: 8px;
    padding: 5px;
}
QToolButton:hover { background: #f1f5ff; border-color: #cddcfb; }
QLabel#statusBadge {
    color: #158368;
    background: #ecf8f2;
    border: 1px solid #d5eee1;
    border-radius: 6px;
    padding: 6px 11px;
    font-size: 8.5pt;
    font-weight: 600;
}
QLabel#statusBadge[status="stopped"] { color: #c34f5a; background: #fff1f2; border-color: #f7dadd; }
QLabel#userAvatar {
    color: #4563a4;
    background: #eef2fb;
    border: 1px solid #e0e7f5;
    border-radius: 17px;
    font-size: 9pt;
    font-weight: 700;
}
QLabel#pageTitle { color: #162741; font-size: 23pt; font-weight: 700; }
QLabel#pageDescription, QLabel#sectionCaption { color: #8490a4; font-size: 9pt; }
QFrame#sectionPanel, QFrame#card, QFrame#statCard, QWidget#surfacePanel {
    background: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 12px;
}
QLabel#sectionTitle, QLabel#cardTitle { color: #253751; font-size: 11pt; font-weight: 700; }
QLabel#sectionNumber {
    color: #2563eb;
    background: #edf3ff;
    border-radius: 8px;
    font-size: 9pt;
    font-weight: 700;
}
QLabel#infoNotice {
    color: #5b7394;
    background: #edf4ff;
    border: 1px solid #dde9fc;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 9pt;
}
QLabel#countBadge { color: #2563eb; background: #edf3ff; border-radius: 6px; padding: 6px 10px; font-size: 9pt; }
QFrame#statCard[variant="facebook"] { border-top: 3px solid #3b82f6; }
QFrame#statCard[variant="groups"] { border-top: 3px solid #14b8a6; }
QFrame#statCard[variant="customers"] { border-top: 3px solid #f3b14d; }
QFrame#statCard[variant="ai"] { border-top: 3px solid #8b7cec; }
QLabel#statTitle { color: #8290a5; font-size: 9pt; font-weight: 600; }
QLabel#statValue { color: #1d3555; font-size: 26pt; font-weight: 700; }
QLabel#activityText, QLabel#statusName { color: #60718a; font-size: 9.5pt; }
QLabel#activityTime { color: #9aa5b5; font-size: 8pt; }
QLabel#iconLabel { font-size: 15pt; }
QWidget#toolbar { background: transparent; }
QPushButton {
    color: #53647e;
    background: #ffffff;
    border: 1px solid #dfe6f0;
    border-radius: 7px;
    padding: 7px 12px;
    font-size: 9pt;
    font-weight: 600;
}
QPushButton:hover { color: #2563eb; background: #f6f9ff; border-color: #b9cff7; }
QPushButton:pressed { background: #eaf1ff; }
QPushButton#toolbarButton[variant="primary"], QPushButton[role="primary"] {
    color: #ffffff;
    background: #2563eb;
    border-color: #2563eb;
}
QPushButton#toolbarButton[variant="primary"]:hover, QPushButton[role="primary"]:hover { background: #1d54d1; border-color: #1d54d1; }
QPushButton#toolbarButton[variant="secondary"] { color: #53647e; background: #ffffff; border-color: #dfe6f0; }
QPushButton#toolbarButton[variant="secondary"]:hover { color: #2563eb; background: #f6f9ff; border-color: #b9cff7; }
QPushButton#toolbarButton[variant="danger"], QPushButton#accountStopButton {
    color: #c34f5a; background: #fff7f7; border-color: #f2dadd;
}
QPushButton#toolbarButton[variant="danger"]:hover, QPushButton#accountStopButton:hover { background: #ffeded; border-color: #edbdc3; }
QPushButton#accountOpenButton { color: #148267; background: #edf9f3; border-color: #d7eee2; }
QPushButton#accountPendingButton { color: #a47b30; background: #fffaeb; border-color: #f3e8c2; }
QPushButton:disabled, QPushButton#toolbarButton:disabled,
QPushButton#accountOpenButton:disabled, QPushButton#accountStopButton:disabled {
    color: #a9b3c3; background: #f5f7fa; border-color: #e8edf4;
}
QPushButton#disclosureButton { color: #59749e; background: transparent; border: none; padding: 3px 0; text-align: left; font-weight: 500; }
QPushButton::menu-indicator { subcontrol-position: right center; right: 7px; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDateEdit, QDateTimeEdit {
    color: #334764;
    background: #ffffff;
    border: 1px solid #dfe6f0;
    border-radius: 7px;
    padding: 7px 10px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus { border-color: #80a9f5; }
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: #9ba7b9; background: #f8fafc; border-color: #e8edf4; }
QComboBox::drop-down, QDateEdit::drop-down, QDateTimeEdit::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: white; color: #334764; selection-background-color: #edf3ff; selection-color: #2563eb; border: 1px solid #dfe6f0; padding: 5px; }
QLineEdit#toolbarSearch { background: #ffffff; border-radius: 7px; padding: 0 12px; }
QCheckBox { color: #61738b; spacing: 8px; font-size: 9pt; }
QCheckBox::indicator { width: 14px; height: 14px; }
QTextBrowser#postPreviewText { background: #ffffff; border: 1px solid #e6ebf2; border-radius: 9px; padding: 14px; }
QListWidget#postMediaList, QListWidget#postMediaFiles {
    background: #ffffff; border: 1px solid #e6ebf2; border-radius: 9px; padding: 6px; outline: none;
}
QListWidget#postMediaList::item { min-height: 29px; padding: 6px 8px; border-radius: 6px; }
QListWidget#postMediaList::item:selected, QListWidget#postMediaFiles::item:selected { color: #2563eb; background: #edf3ff; }
QLabel#postMediaPreview { color: #98a5b8; background: #f9fbff; border: 1px dashed #dbe4f2; border-radius: 9px; padding: 10px; }
QTableWidget#baseTable {
    color: #526680; background: #ffffff; alternate-background-color: #fafcff;
    border: 1px solid #e6ebf2; border-radius: 10px; outline: none;
    font-size: 9pt; gridline-color: #edf1f7;
    selection-background-color: #edf3ff; selection-color: #2563eb;
}
QTableWidget#baseTable::item { padding: 8px 12px; border-bottom: 1px solid #edf1f7; }
QTableWidget#baseTable::item:hover { background: #f7faff; }
QTableWidget#baseTable::item:selected { color: #2563eb; background: #edf3ff; }
QHeaderView::section {
    color: #7d8ca2; background: #f8fafd; border: none; border-bottom: 1px solid #e6ebf2;
    padding: 11px 12px; font-size: 8.5pt; font-weight: 600;
}
QLabel#statusValue { font-size: 9pt; font-weight: 600; }
QLabel#statusValue[state="ok"] { color: #15967c; }
QLabel#statusValue[state="error"] { color: #ce5664; }
QLabel#statusValue[state="warning"] { color: #c39038; }
QLabel#statusValue[state="idle"] { color: #95a1b4; }
QLabel#statusBar { color: #95a0b3; background: #ffffff; border-top: 1px solid #e8edf4; padding: 0 24px; font-size: 8.5pt; }
QListWidget#logWidget { color: #8090a7; background: #f9fbfe; border: 1px solid #e9eef5; border-radius: 8px; padding: 8px; font-family: "Consolas"; font-size: 8.5pt; outline: none; }
QListWidget#logWidget::item { padding: 5px 6px; }
QListWidget#logWidget::item:selected { background: #edf3ff; }
QProgressBar { color: #587498; background: #eaf0f8; border: none; border-radius: 4px; height: 8px; text-align: center; }
QProgressBar::chunk { background: #3b82f6; border-radius: 4px; }
QFrame#loadingBox { background: #ffffff; border: 1px solid #e6ebf2; border-radius: 12px; }
QLabel#loadingTitle { color: #253751; font-size: 14pt; font-weight: 700; }
QLabel#loadingMessage { color: #8490a4; }
QLabel#comingSoonText { color: #8998ae; font-size: 24pt; font-weight: 600; }
QScrollBar:vertical, QScrollBar:horizontal { background: transparent; border: none; margin: 2px; }
QScrollBar:vertical { width: 8px; }
QScrollBar:horizontal { height: 8px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #d3dce9; border-radius: 3px; min-height: 26px; min-width: 26px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #b4c4db; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { border: none; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }
QSplitter::handle { background: transparent; }
QDialog, QMessageBox, QMenu { background: #ffffff; }
QMenu { border: 1px solid #e2e8f1; border-radius: 8px; padding: 6px; }
QMenu::item { color: #53647e; padding: 9px 18px; border-radius: 5px; }
QMenu::item:selected { color: #2563eb; background: #edf3ff; }
QMenu::item:disabled { color: #a9b3c3; }
QToolTip { color: #ffffff; background: #263a57; border: none; border-radius: 5px; padding: 6px 9px; font-size: 9pt; }
QFrame#statCard[variant="facebook"] QLabel#statValue { font-size: 16pt; }
QLabel#emptyState { color: #92a1b6; font-size: 10pt; padding: 24px; }
QComboBox::down-arrow, QDateEdit::down-arrow, QDateTimeEdit::down-arrow { image: url("@assets@/chevron-down.svg"); width: 12px; height: 12px; }
QSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 23px; border: none; border-left: 1px solid #edf1f7; border-top-right-radius: 7px; background: #f8fafd; }
QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 23px; border: none; border-left: 1px solid #edf1f7; border-bottom-right-radius: 7px; background: #f8fafd; }
QSpinBox::up-arrow { image: url("@assets@/chevron-up.svg"); width: 10px; height: 10px; }
QSpinBox::down-arrow { image: url("@assets@/chevron-down.svg"); width: 10px; height: 10px; }
QTabWidget#outreachTabs::pane {
    border: 1px solid #dbe4f0;
    border-radius: 10px;
    background: #ffffff;
    top: -1px;
}
QTabWidget#outreachTabs QTabBar::tab {
    background: #edf2f9;
    color: #52627c;
    padding: 10px 14px;
    margin-right: 4px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QTabWidget#outreachTabs QTabBar::tab:selected {
    background: #ffffff;
    color: #2563eb;
    border: 1px solid #dbe4f0;
    border-bottom-color: #ffffff;
}
