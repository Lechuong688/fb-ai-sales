/* Facebook AI Sales - refreshed indigo, teal and coral theme */

QWidget {
    color: #202945;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow,
QWidget#mainContent {
    background-color: #F3F6FC;
}

QFrame#header {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E6EAF4;
}

QLabel#breadcrumb {
    color: #44516F;
    font-size: 12pt;
    font-weight: 700;
    padding: 4px 0;
    background: transparent;
}

QLabel#statusBadge {
    color: #087F70;
    background-color: #DDF8F1;
    border: 1px solid #B9EDE2;
    border-radius: 16px;
    padding: 7px 15px;
    font-size: 9pt;
    font-weight: 700;
}

QLabel#statusBadge[status="stopped"] {
    color: #B34354;
    background-color: #FFF0F1;
    border: 1px solid #F5CDD2;
}

QListWidget#sidebar {
    color: #D8E0F2;
    background-color: #171D3A;
    border: none;
    padding: 18px 12px;
    outline: none;
}

QListWidget#sidebar::item {
    color: #B7C3DD;
    min-height: 44px;
    padding: 0 14px;
    margin: 3px 0;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: 600;
}

QListWidget#sidebar::item:hover {
    color: #FFFFFF;
    background-color: #252D50;
}

QListWidget#sidebar::item:selected {
    color: #FFFFFF;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #5265E8, stop:1 #7859E8);
    border-left: 3px solid #46D6C6;
    font-weight: 700;
}

QLabel#pageTitle {
    color: #182342;
    font-size: 25pt;
    font-weight: 800;
}

QLabel#pageDescription {
    color: #7783A0;
    font-size: 10pt;
}

QFrame#statCard,
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E6EAF3;
    border-radius: 16px;
}

QFrame#statCard[variant="facebook"] {
    border-left: 4px solid #1877F2;
}

QFrame#statCard[variant="groups"] {
    border-left: 4px solid #15B8A6;
}

QFrame#statCard[variant="customers"] {
    border-left: 4px solid #F2A640;
}

QFrame#statCard[variant="ai"] {
    border-left: 4px solid #8A63E6;
}

QFrame#statCard[variant="facebook"] QLabel#statValue { color: #1769D2; }
QFrame#statCard[variant="groups"] QLabel#statValue { color: #0B9A89; }
QFrame#statCard[variant="customers"] QLabel#statValue { color: #C98218; }
QFrame#statCard[variant="ai"] QLabel#statValue { color: #7551C8; }

QLabel#statTitle {
    color: #7B86A1;
    font-size: 9pt;
    font-weight: 700;
}

QLabel#statValue {
    color: #1C2948;
    font-size: 27pt;
    font-weight: 800;
}

QLabel#cardTitle {
    color: #253354;
    font-size: 13pt;
    font-weight: 750;
    margin-bottom: 4px;
}

QLabel#activityText,
QLabel#statusName {
    color: #586783;
    font-size: 10pt;
}

QLabel#activityTime {
    color: #9AA4BA;
    font-size: 8pt;
}

QLabel#iconLabel {
    font-size: 15pt;
}

QWidget#toolbar {
    background: transparent;
}

QPushButton {
    color: #44516F;
    background-color: #EEF1F9;
    border: 1px solid #DDE3F0;
    border-radius: 9px;
    padding: 8px 14px;
    font-size: 9pt;
    font-weight: 650;
}

QPushButton:hover {
    color: #3445B8;
    background-color: #E5E9FF;
    border-color: #C8D0FB;
}

QPushButton:pressed {
    background-color: #D8DEFF;
}

QPushButton:disabled {
    color: #99A3B8;
    background-color: #F1F3F8;
    border-color: #E4E8F0;
}

QPushButton#toolbarButton[variant="primary"] {
    color: #FFFFFF;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #5865E8, stop:1 #795AE8);
    border: 1px solid #5865E8;
}

QPushButton#toolbarButton[variant="primary"]:hover {
    background-color: #4855D6;
    border-color: #4855D6;
}

QPushButton#toolbarButton[variant="secondary"] {
    color: #4857C8;
    background-color: #EEF0FF;
    border-color: #D9DEFF;
}

QPushButton#toolbarButton[variant="secondary"]:hover {
    background-color: #E3E7FF;
}

QPushButton#toolbarButton[variant="danger"] {
    color: #B34354;
    background-color: #FFF0F1;
    border-color: #F3D0D5;
}

QPushButton#toolbarButton[variant="danger"]:hover {
    background-color: #FFE3E7;
    border-color: #EDB9C1;
}

QPushButton#accountOpenButton {
    color: #087F70;
    background-color: #DDF8F1;
    border-color: #B9EDE2;
}

QPushButton#accountOpenButton:hover {
    background-color: #C8F2E9;
}

QPushButton#accountStopButton {
    color: #B34354;
    background-color: #FFF0F1;
    border-color: #F3D0D5;
}

QPushButton#accountStopButton:hover {
    background-color: #FFE3E7;
}

QPushButton#accountPendingButton {
    color: #8B6B22;
    background-color: #FFF6D9;
    border-color: #F1E3AE;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox {
    color: #263451;
    background-color: #FFFFFF;
    border: 1px solid #DCE2EF;
    border-radius: 9px;
    padding: 8px 11px;
    selection-background-color: #5865E8;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #6874EC;
    background-color: #FFFFFF;
}

QLineEdit#toolbarSearch {
    min-height: 34px;
    border-radius: 18px;
    padding: 0 15px;
    background-color: #F8F9FD;
}

QTextBrowser#postPreviewText {
    color: #263451;
    background-color: #FFFFFF;
    border: 1px solid #E1E6F0;
    border-radius: 13px;
    padding: 12px;
    selection-background-color: #5865E8;
    selection-color: #FFFFFF;
}

QListWidget#postMediaList,
QListWidget#postMediaFiles {
    color: #35415F;
    background-color: #FFFFFF;
    border: 1px solid #E1E6F0;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QListWidget#postMediaList::item {
    min-height: 31px;
    padding: 6px 8px;
    border-radius: 6px;
}

QListWidget#postMediaList::item:selected,
QListWidget#postMediaFiles::item:selected {
    color: #3445B8;
    background-color: #E9ECFF;
}

QLabel#postMediaPreview {
    color: #7783A0;
    background-color: #F8F9FD;
    border: 1px dashed #D5DCEC;
    border-radius: 12px;
    padding: 10px;
}

QTableWidget#baseTable {
    color: #35415F;
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFE;
    border: 1px solid #E1E6F0;
    border-radius: 13px;
    outline: none;
    font-size: 9.5pt;
    gridline-color: #EEF1F7;
    selection-background-color: #E9ECFF;
    selection-color: #3445B8;
}

QTableWidget#baseTable::item {
    padding: 7px 12px;
    border-bottom: 1px solid #EDF0F6;
}

QTableWidget#baseTable::item:hover {
    background-color: #F3F5FF;
}

QTableWidget#baseTable::item:selected {
    background-color: #E9ECFF;
    color: #3445B8;
}

QHeaderView::section {
    color: #687594;
    background-color: #F5F7FC;
    border: none;
    border-bottom: 1px solid #E1E6F0;
    padding: 10px 12px;
    font-size: 9pt;
    font-weight: 750;
}

QLabel#statusValue {
    font-size: 10pt;
    font-weight: 750;
}

QLabel#statusValue[state="ok"] { color: #0B9A82; }
QLabel#statusValue[state="error"] { color: #D74B62; }
QLabel#statusValue[state="warning"] { color: #C98716; }
QLabel#statusValue[state="idle"] { color: #7B86A1; }

QLabel#statusBar {
    color: #74809A;
    background-color: #FFFFFF;
    border-top: 1px solid #E6EAF4;
    padding: 0 16px;
    font-size: 9pt;
}

QListWidget#logWidget {
    color: #56627D;
    background-color: #FBFCFF;
    border: 1px solid #E3E8F2;
    border-radius: 12px;
    padding: 8px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 9pt;
    outline: none;
}

QListWidget#logWidget::item {
    padding: 5px 7px;
    border-radius: 6px;
}

QListWidget#logWidget::item:hover { background-color: #F0F3FC; }
QListWidget#logWidget::item:selected { background-color: #E9ECFF; }

QProgressBar {
    color: #FFFFFF;
    background-color: #E8ECF5;
    border: none;
    border-radius: 5px;
    height: 9px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #5865E8;
    border-radius: 5px;
}

QFrame#loadingBox {
    background-color: #FFFFFF;
    border: 1px solid #E4E8F1;
    border-radius: 18px;
}

QLabel#loadingTitle {
    color: #253354;
    font-size: 14pt;
    font-weight: 750;
}

QLabel#loadingMessage { color: #7783A0; }
QLabel#comingSoonText { color: #74809A; font-size: 25pt; font-weight: 800; }

QScrollBar:vertical,
QScrollBar:horizontal {
    background: transparent;
    border: none;
    margin: 2px;
}

QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #C9D1E2;
    border-radius: 5px;
    min-height: 26px;
    min-width: 26px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover { background: #AAB6CE; }

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

QToolTip {
    color: #FFFFFF;
    background-color: #202945;
    border: 1px solid #3A4666;
    border-radius: 6px;
    padding: 6px 8px;
}

QMessageBox { background-color: #F7F8FC; }
