/* theme.qss */

QFrame#card {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

QLabel#cardTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1e293b;
    margin-bottom: 8px; /* Khoảng cách dưới tiêu đề */
}

QLabel#activityText {
    font-size: 14px;
    color: #475569;
}

QLabel#iconLabel {
    font-size: 16px;
}

/* =========================================
   BaseTable Styles
========================================= */

QTableWidget#baseTable {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    outline: none; /* Bỏ viền nét đứt khi focus */
    color: #334155;
    font-size: 14px;
}

/* Các ô trong bảng */
QTableWidget#baseTable::item {
    padding: 4px 12px;
    border-bottom: 1px solid #f1f5f9; /* Chỉ tạo đường kẻ ngang (row divider) */
}

/* Hiệu ứng khi di chuột qua dòng */
QTableWidget#baseTable::item:hover {
    background-color: #f8fafc;
}

/* Hiệu ứng khi chọn dòng */
QTableWidget#baseTable::item:selected {
    background-color: #e0f2fe; /* Nền xanh nhạt */
    color: #0369a1; /* Chữ xanh đậm */
}

/* Tiêu đề bảng (Header) */
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 12px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}

/* Tùy chỉnh thanh cuộn (Scrollbar) cho hiện đại */
QScrollBar:vertical {
    border: none;
    background: #f8fafc;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* =========================================
   Breadcrumb Styles
========================================= */

QLabel#breadcrumb {
    font-size: 16px;
    font-weight: bold;
    color: #334155; /* Màu xám đậm sang trọng */
    padding: 4px 0px; /* Thêm chút đệm trên/dưới để không bị sát lề */
    background: transparent; /* Nền trong suốt */
}

/* =========================================
   Header Styles
========================================= */

QFrame#header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0; /* Đường viền mờ ngăn cách header và phần dưới */
}

/* Biến Label thành dạng Badge/Pill */
QLabel#statusBadge {
    background-color: #dcfce7; /* Nền xanh lá cực nhạt */
    color: #166534; /* Chữ xanh lá đậm */
    font-weight: bold;
    font-size: 13px;
    padding: 6px 14px; /* Tạo không gian bên trong để giống viên thuốc */
    border-radius: 14px; /* Bo góc bằng một nửa chiều cao để tạo hình oval (Pill) */
    border: 1px solid #bbf7d0; /* Viền mờ bao quanh badge */
}

/* Trạng thái lỗi hoặc dừng (Sử dụng dynamic property) */
QLabel#statusBadge[status="stopped"] {
    background-color: #fee2e2; /* Nền đỏ nhạt */
    color: #991b1b; /* Chữ đỏ đậm */
    border: 1px solid #fecaca;
}

/* =========================================
   Loading Widget Styles
========================================= */

/* Lớp phủ bên ngoài làm mờ ứng dụng */
QWidget#loadingOverlay {
    background-color: rgba(15, 23, 42, 0.6); /* Nền đen/xanh navy bóng mờ 60% */
}

/* Hộp thoại hiển thị Loading ở giữa */
QFrame#loadingBox {
    background-color: #ffffff;
    border-radius: 16px;
}

QLabel#loadingTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1e293b;
}

QLabel#loadingMessage {
    font-size: 14px;
    color: #64748b; /* Màu xám nhạt hơn title */
}

/* Tùy chỉnh thanh Progress Bar */
QProgressBar {
    background-color: #f1f5f9; /* Nền thanh xám cực nhạt */
    border: none;
    border-radius: 4px;
    height: 8px; /* Làm cho thanh nhỏ và thanh lịch hơn */
}

/* Cục chạy bên trong Progress Bar */
QProgressBar::chunk {
    background-color: #3b82f6; /* Nền xanh dương hiện đại */
    border-radius: 4px;
}

/* =========================================
   Log Widget Styles
========================================= */

QListWidget#logWidget {
    background-color: #f8fafc; /* Nền xám cực nhạt, tạo cảm giác khu vực code/log */
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas", "Courier New", "Monaco", monospace; /* Font chữ đơn cách */
    font-size: 13px;
    outline: none;
}

/* Các dòng log bên trong */
QListWidget#logWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
}

QListWidget#logWidget::item:hover {
    background-color: #f1f5f9;
}

QListWidget#logWidget::item:selected {
    background-color: #e0f2fe;
}

/* Lưu ý: Thanh cuộn (Scrollbar) sẽ tự động lấy giao diện đẹp 
   mà chúng ta đã thiết kế ở phần BaseTable trước đó. */

   /* =========================================
   Page Header Styles
========================================= */

QLabel#pageTitle {
    font-size: 26px; /* Chữ to, nổi bật */
    font-weight: 900; /* In đậm (Extra Bold) */
    color: #0f172a; /* Màu xám đen thẫm */
    letter-spacing: -0.5px; /* Ép khoảng cách các chữ gần lại một chút cho hiện đại */
}

QLabel#pageDescription {
    font-size: 15px;
    color: #64748b; /* Màu xám dịu mắt, không tranh giành sự chú ý với Title */
}

/* =========================================
   Sidebar Styles
========================================= */

QListWidget#sidebar {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #e2e8f0; /* Kẻ một đường viền mờ bên phải để phân cách */
    padding: 16px 12px; /* Lùi vào một chút cho các item không dính sát lề */
    outline: none;
}

/* Các mục (menu items) trong Sidebar */
QListWidget#sidebar::item {
    color: #475569; /* Màu chữ xám tĩnh */
    font-size: 15px;
    font-weight: 500;
    padding: 0px 16px; 
    border-radius: 8px; /* Bo góc mềm mại cho item */
}

/* Khi người dùng di chuột qua (Hover) */
QListWidget#sidebar::item:hover {
    background-color: #f1f5f9; /* Đổi nền xám cực nhạt */
    color: #0f172a; /* Chữ đậm lên */
}

/* Khi người dùng click chọn trang đó (Selected) */
QListWidget#sidebar::item:selected {
    background-color: #e0f2fe; /* Nền xanh dương nhạt */
    color: #0284c7; /* Chữ màu xanh đậm */
    font-weight: bold;
}

/* =========================================
   Stat Card Styles
========================================= */

QFrame#statCard {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

/* Tiêu đề của StatCard (Chữ nhỏ, màu xám) */
QLabel#statTitle {
    font-size: 14px;
    font-weight: 600; /* Hơi đậm một chút */
    color: #64748b; 
}

/* Con số của StatCard (Chữ rất to, đậm, màu tối) */
QLabel#statValue {
    font-size: 32px; 
    font-weight: 900; /* In đậm (Black) */
    color: #0f172a; 
}

/* =========================================
   Status Bar Styles
========================================= */

QLabel#statusBar {
    background-color: #f8fafc; /* Nền xám cực nhạt (slate-50) để làm nền phụ */
    border-top: 1px solid #e2e8f0; /* Đường kẻ mờ ở trên cùng */
    color: #475569; /* Chữ màu xám dịu mắt */
    font-size: 13px; /* Size chữ nhỏ hơn bình thường một chút */
    font-weight: 500;
    padding: 0px 16px; /* Cách lề trái/phải 16px - Thay thế cho dấu cách thủ công */
}

/* =========================================
   System Status Styles
========================================= */

QLabel#statusName {
    font-size: 14px;
    color: #475569; /* Màu xám tối */
    font-weight: 500;
}

QLabel#statusValue {
    font-size: 14px;
    font-weight: bold;
}

/* Các trạng thái màu sắc tự động cập nhật */
QLabel#statusValue[state="ok"] {
    color: #16a34a; /* Xanh lá */
}
QLabel#statusValue[state="error"] {
    color: #dc2626; /* Đỏ */
}
QLabel#statusValue[state="warning"] {
    color: #d97706; /* Cam */
}
QLabel#statusValue[state="idle"] {
    color: #64748b; /* Xám */
}

/* =========================================
   Main Window Styles
========================================= */

/* Nền của khu vực nội dung chính (Nằm dưới các Card) */
QWidget#mainContent {
    background-color: #f1f5f9; /* Màu Slate 100 - Xám cực nhạt */
}

/* Định dạng cho chữ ở trang "Coming Soon" */
QLabel#comingSoonText {
    font-size: 28px;
    font-weight: 800;
    color: #94a3b8; /* Slate 400 - Màu xám để không quá chói mắt */
}

/* =========================================
   Toolbar Styles
========================================= */

/* Nút bấm (Buttons) */
QPushButton#toolbarButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1; /* Viền xám nhạt */
    border-radius: 6px; /* Bo góc nhẹ tạo cảm giác cứng cáp */
    color: #334155;
    font-weight: 500;
    font-size: 14px;
    padding: 0px 16px; /* Khoảng cách chữ tới viền trái/phải */
}

/* Hiệu ứng khi lướt chuột qua nút */
QPushButton#toolbarButton:hover {
    background-color: #f8fafc;
    border: 1px solid #94a3b8; /* Viền đậm lên một chút */
}

/* Hiệu ứng khi bấm chuột xuống */
QPushButton#toolbarButton:pressed {
    background-color: #e2e8f0;
}

/* Ô tìm kiếm (Search Box) */
QLineEdit#toolbarSearch {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 18px; /* Bo góc bằng một nửa chiều cao (36/2) để tạo hình viên thuốc */
    padding: 0px 16px;
    color: #0f172a;
    font-size: 14px;
}

/* Hiệu ứng khi click vào ô tìm kiếm (Focus) */
QLineEdit#toolbarSearch:focus {
    border: 1px solid #3b82f6; /* Viền chuyển sang xanh dương đậm */
    background-color: #ffffff;
}